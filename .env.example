# ─────────────────────────────────────────────────────────────────────────────
# VCUBE Academy — Environment Configuration Template
#
# INSTRUCTIONS:
#   1. Copy this file to .env in the project root
#   2. Replace ALL placeholder values with real, secure values
#   3. NEVER commit the real .env file to source control
#   4. Add .env to your .gitignore
# ─────────────────────────────────────────────────────────────────────────────

# ─── PostgreSQL Database ─────────────────────────────────────────────────────
POSTGRES_DB=vcube_academy
POSTGRES_USER=vcube_user
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password_here

DATABASE_URL=jdbc:postgresql://postgres:5432/vcube_academy
DATABASE_USERNAME=vcube_user
DATABASE_PASSWORD=CHANGE_ME_strong_db_password_here

# ─── Security & JWT ───────────────────────────────────────────────────────────
# REQUIRED: Generate a cryptographically secure 256-bit random key.
# Example command: openssl rand -base64 64
JWT_SECRET=CHANGE_ME_generate_a_secure_256bit_random_key_here
JWT_EXPIRATION_MS=86400000

# ─── CORS & Network ──────────────────────────────────────────────────────────
# Set to the exact origin(s) where your frontend is served.
# Separate multiple origins with a comma (no spaces).
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://academy.vcube.com

# ─── Frontend Build ───────────────────────────────────────────────────────────
# The full URL to the backend API, as seen by the user's browser.
VITE_API_BASE_URL=http://localhost:8080/api

# ─── Optional: External AI Provider ─────────────────────────────────────────
# Leave AI_API_KEY blank or omit AI_PROVIDER to use the built-in engine.
AI_PROVIDER=BUILTIN
AI_API_KEY=
